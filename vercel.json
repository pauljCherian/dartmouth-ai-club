{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": null,
  "buildCommand": "node tools/build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/meeting-materials",
      "destination": "/speakers",
      "permanent": true
    },
    {
      "source": "/resources",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/reading-lists",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/images/chetan-patel-poster.png",
      "destination": "/speakers",
      "permanent": true
    },
    {
      "source": "/reading",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
